{
  "name": "@smarthome/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js --packages=external --alias:@smarthome/shared=../../packages/shared/src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@influxdata/influxdb-client": "^1.35.0",
    "fastify": "^5.6.0",
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@smarthome/shared": "*",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
