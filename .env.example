# Wird auf dem Pi nach .env kopiert. .env ist gitignored – niemals committen.

# InfluxDB 2.x  (READ-ONLY Token verwenden!)
INFLUX_URL=http://10.0.0.1:8086
INFLUX_ORG=paul
INFLUX_BUCKET=smarthome
INFLUX_TOKEN=

# MQTT-Broker
MQTT_HOST=10.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=mqttuser
MQTT_PASSWORD=
# Live-Werte des Autos per MQTT, z.B. saic/<konto>/vehicles/<VIN> (leer: aus Influx). MQTT=0: Live nur aus Influx
MQTT_CAR_PREFIX=
