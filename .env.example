# Wird auf dem Pi nach .env kopiert. .env ist gitignored – niemals committen.

# InfluxDB 2.x  (READ-ONLY Token verwenden!)
INFLUX_URL=http://10.0.0.1:8086
INFLUX_ORG=paul
INFLUX_BUCKET=smarthome
INFLUX_TOKEN=

# MQTT-Broker
MQTT_HOST=10.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=mqttuser
MQTT_PASSWORD=
# Live-Werte des Autos per MQTT, z.B. saic/<konto>/vehicles/<VIN> (leer: aus Influx). MQTT=0: Live nur aus Influx
MQTT_CAR_PREFIX=

# Miele 3rd-Party-API (developer.miele.com): Restzeit/Programm von Waschmaschine & Geschirrspüler. Leer = aus.
# Danach in der App: Einstellungen → Miele → „Mit Miele verbinden“. MIELE_AUTH=legacy für den alten Login-Server.
MIELE_CLIENT_ID=
MIELE_CLIENT_SECRET=
# PushWard (pushward.app): Live-Aktivitäten / Dynamic Island. Schlüssel hlk_… aus der PushWard-App. Leer = aus.
PUSHWARD_KEY=

# PV-Prognose (Open-Meteo) + Lade-Empfehlung Auto
FORECAST_LAT=
FORECAST_LON=
# MG5: nutzbare Akkukapazität (kWh), Ziel-Ladestand (%), Tage, in denen der PV-Überschuss reichen soll
CAR_CAPACITY_KWH=57
CAR_TARGET_SOC=80
CAR_HORIZON_DAYS=3
